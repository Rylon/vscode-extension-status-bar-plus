{
  "name": "status-bar-plus",
  "displayName": "StatusBar+",
  "description": "StatusBar+ is a small extension which adds a couple of useful items to your VS Code statusbar, including a better line and column counter, and Git worktree indicators.",
  "icon": "icon.png",
  "version": "1.4.0",
  "publisher": "rylon",
  "repository": {
    "type": "git",
    "url": "https://github.com/rylon/vscode-extension-status-bar-plus"
  },
  "bugs": {
    "url": "https://github.com/rylon/vscode-extension-status-bar-plus/issues"
  },
  "license": "SEE LICENSE IN COPYING",
  "engines": {
    "vscode": "^1.109.0",
    "npm": ">=11.10.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
